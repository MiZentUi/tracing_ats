# Скопируй в .env и вставь ключ OpenRouter. Файл .env не коммитить.
OPENROUTER_API_KEY=

# scoring-service: mock (по умолчанию, без сети) или openai.
SCORING_SERVICE_LLM_PROVIDER=mock
# Для openai укажи base URL и модель; ключ берётся из OPENROUTER_API_KEY.
SCORING_SERVICE_LLM_BASE_URL=https://openrouter.ai/api/v1
SCORING_SERVICE_LLM_MODEL=
# Reasoning-моделям нужен запас токенов на reasoning, иначе content пустой.
SCORING_SERVICE_LLM_MAX_OUTPUT_TOKENS=4096
# Таймаут одного запроса к LLM внутри scoring-service.
SCORING_SERVICE_LLM_TIMEOUT_SECONDS=30
# Дедлайн gRPC-вызова из ats-service: должен быть больше времени ответа модели.
ATS_SCORING_DEADLINE=60s

# Куда ats-service ходит за скорингом. Для заглушки:
# SCORING_GRPC_TARGET=mock-scoring:8082
SCORING_GRPC_TARGET=scoring-service:8082
# Хостовый порт заглушки scoring-service (compose-профиль mock-scoring).
MOCK_SCORING_PORT=8083
# Сколько вакансий уходит в один gRPC-вызов «вакансии под резюме».
ATS_RESUME_MATCH_BATCH_SIZE=3
