# База конфигурации. Локально: скопируй в .env и заполни ключи.
# На VPS .env.example используется как база, а модельные ключи/домены/имена
# приходят из GitHub Environment и overlay-файла .env.production.
OPENROUTER_API_KEY=

# ats-service: извлечение требований вакансии, генерация словаря, письма.
# Ключ можно задать отдельно; если пуст, используется OPENROUTER_API_KEY.
VACANCY_LLM_BASE_URL=https://openrouter.ai/api/v1
VACANCY_LLM_MODEL=dots-studio/dots-3-note-preview:free
VACANCY_LLM_API_KEY=

# Запасной провайдер: Cloudflare Workers AI, OpenAI-совместимый endpoint.
# Включается явно и используется только если OpenRouter недоступен.
# base-url: https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
# api-token: Account > Workers AI > Read.
CLOUDFLARE_AI_ENABLED=true
CLOUDFLARE_AI_BASE_URL=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/qwen/qwen3.8-27b
# low | medium | xhigh; для извлечения требований достаточно low.
CLOUDFLARE_AI_REASONING_EFFORT=low

# scoring-service: mock (по умолчанию, без сети) или openai.
SCORING_SERVICE_LLM_PROVIDER=mock
# Для openai укажи base URL и модель. Ключ по умолчанию берётся из
# OPENROUTER_API_KEY; отдельный ключ можно задать в SCORING_SERVICE_LLM_API_KEY.
SCORING_SERVICE_LLM_BASE_URL=https://openrouter.ai/api/v1
SCORING_SERVICE_LLM_MODEL=
SCORING_SERVICE_LLM_API_KEY=
# Reasoning-моделям нужен запас токенов на reasoning, иначе content пустой.
SCORING_SERVICE_LLM_MAX_OUTPUT_TOKENS=16384
# Таймаут одного запроса к LLM внутри scoring-service.
SCORING_SERVICE_LLM_TIMEOUT_SECONDS=300
# Дедлайн gRPC-вызова из ats-service: должен быть больше времени ответа модели.
ATS_SCORING_DEADLINE=600s

# Куда ats-service ходит за скорингом. Для заглушки:
# SCORING_GRPC_TARGET=mock-scoring:8082
SCORING_GRPC_TARGET=scoring-service:8082
# Хостовый порт заглушки scoring-service (compose-профиль mock-scoring).
MOCK_SCORING_PORT=8083
# Сколько вакансий уходит в один gRPC-вызов «вакансии под резюме».
ATS_RESUME_MATCH_BATCH_SIZE=3

# dictionary-service: словарь навыков и алиасы.
DICTIONARY_SERVICE_PORT=8084
DICTIONARY_LOG_LEVEL=INFO
DICTIONARY_SERVICE_TOKEN=
# ats и scoring ходят в словарь; при недоступности работают по точному ключу.
ATS_DICTIONARY_ENABLED=true
DICTIONARY_GRPC_TARGET=dictionary-service:8084
SCORING_SERVICE_DICTIONARY_ENABLED=true
SCORING_SERVICE_DICTIONARY_TARGET=dictionary-service:8084
SCORING_SERVICE_DICTIONARY_DEADLINE_SECONDS=2

# Production / VPS. .env.example — база; реальные секреты приходят из GitHub
# в .env.production. Локально можно скопировать этот файл в .env.
FRONTEND_PORT=3000
POSTGRES_DB=ats
POSTGRES_USER=ats
POSTGRES_PASSWORD=ats
# Base64-ключ AES-256-GCM; сгенерируй отдельно для production.
ATS_PII_ENCRYPTION_KEY=
ATS_S3_ACCESS_KEY=minioadmin
ATS_S3_SECRET_KEY=minioadmin
ATS_S3_BUCKET=ats-resumes
