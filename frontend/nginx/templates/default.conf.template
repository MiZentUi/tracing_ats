server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        # Docker DNS: при пересоздании ats-service его IP меняется, а nginx
        # не должен держать старый адрес до ручного рестарта.
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $ats_service "${ATS_SERVICE_URL}";
        proxy_pass $ats_service;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Бэкенд может молчать до total-timeout (+запас): ждём дольше него.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
